# O Caddy pega sozinho um certificado HTTPS (Let's Encrypt) para o domínio e renova antes de vencer.
# Quem acessar por http:// é mandado para https://.
{$DOMINIO} {
	encode gzip
	reverse_proxy api:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
